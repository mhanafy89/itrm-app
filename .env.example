# Copy to .env and fill in. The app loads it automatically (real environment variables win).
SQL_SERVER=ServerNameHere
SQL_PORT=port_here
SQL_DATABASE=database_here
SQL_USER=user_here
SQL_PASSWORD=password_here

# Optional
SQL_ENCRYPT=true                      # set false only for local servers without TLS
SQL_TRUST_SERVER_CERTIFICATE=true     # set true for self-signed certificates (dev)
# SQL_CREATE_DATABASE=false             # true: create SQL_DATABASE on startup if it doesn't exist (needs CREATE DATABASE rights)
# SQL_POOL_MAX=10
# PORT=3000

# Login (see db/seed.js) -- only used the first time the users table is seeded
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=admin123
# COOKIE_SECURE=true                    # set true only when the app is served over HTTPS

