<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS reverse proxy: forwards every request to the Node app on 127.0.0.1:3000.
     Requires the IIS "URL Rewrite" module and "Application Request Routing (ARR)" with proxy enabled.
     If you change PORT in .env, change the port in the rewrite URL below too. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let the app's own JSON error responses (401/403/404/500) reach the browser untouched. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- The import feature uploads files up to 30 MB (base64 in JSON); IIS defaults to ~28 MB. -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
